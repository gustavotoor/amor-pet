/**
 * Arquivo de configuração para variáveis de ambiente
 * Sistema Amor Pet
 * 
 * Este arquivo contém as variáveis de ambiente necessárias para o funcionamento
 * do sistema. Em um ambiente de produção, estas variáveis devem ser configuradas
 * no servidor e não versionadas no repositório.
 */

# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Configurações do Banco de Dados
DB_HOST=localhost
DB_USER=amorpet
DB_PASSWORD=amorpet123
DB_NAME=amorpet

# Configurações de Segurança
JWT_SECRET=amor_pet_secret_key_development
JWT_EXPIRES_IN=24h

# Configurações de E-mail
EMAIL_USER=amorpet.noreply@gmail.com
EMAIL_PASS=senha_aplicativo

# Configurações do Google OAuth
GOOGLE_CLIENT_ID=seu_client_id_google
GOOGLE_CLIENT_SECRET=seu_client_secret_google
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Configurações do Pix (Exemplo genérico)
PIX_KEY=amorpet@exemplo.com
PIX_MERCHANT_NAME=Amor Pet
